{
  "manifest_version": 3,
  "name": "MetaStackr GitHub Sync",
  "version": "1.0.0",
  "description": "Orchestrates multi-repo submodules and cascades merges directly inside the GitHub Pull Request interface.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://api.metastac.kr/*",
    "http://localhost:8080/*",
    "https://gitlab.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://github.com/*/*/pull/*",
        "https://gitlab.com/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "style.css"
      ],
      "run_at": "document_end"
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {}
}
